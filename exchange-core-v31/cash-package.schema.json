{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCB-CASH-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "direction",
    "amount",
    "currency",
    "effectiveDate",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "KCB-CASH-1"
    },
    "packageId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "direction": {
      "enum": [
        "in",
        "out"
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "const": "EUR"
    },
    "effectiveDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "targetIds": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "KCB-CHECK-1"
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    }
  }
}
